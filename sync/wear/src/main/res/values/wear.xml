<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The watch sends drinks to nodes with this capability (WearProtocol.PHONE_CAPABILITY). Google Play services
         reads it by this exact name, so it cannot take the module prefix. -->
    <string-array name="android_wear_capabilities" translatable="false" tools:ignore="UnusedResources,ResourceName">
        <item>dhmo_phone</item>
    </string-array>
</resources>
